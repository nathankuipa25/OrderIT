{
  "name": "orderit",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "postinstall": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "node prisma/seed.js",
    "db:create-admin": "node prisma/create-admin.js",
    "test": "node --test tests/*.test.mjs",
    "android:apk": "cd android && ./gradlew assembleStandalone",
    "android:apk:dev": "cd android && ./gradlew assembleDebug",
    "android:install": "cd android && ./gradlew installStandalone",
    "android:install:dev": "cd android && ./gradlew installDebug",
    "mobile:start": "npx react-native start --config mobile/metro.config.js"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.1.0",
    "@dnd-kit/sortable": "^8.0.0",
